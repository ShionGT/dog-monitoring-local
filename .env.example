# =============================================================================
# Dog Monitor — example environment file
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust:   cp .env.example .env
# Real values in `.env` are git-ignored — never commit secrets.
# Every variable is optional; the defaults shown here match config.py and are
# chosen to be privacy-safe (camera off at startup, detection disabled).
# =============================================================================

# --- Environment -------------------------------------------------------------
# development | production  (production requires SECRET_KEY and enables HSTS)
APP_ENV=development

# --- Platform / hardware backend ---------------------------------------------
# auto     = real GPIO+camera only if we appear to be on a Raspberry Pi, else mock
# mock     = force simulation (macOS / CI — "just works")
# hardware = force real GPIO + camera (fails loudly if unavailable)
PLATFORM=auto

# --- Web login ---------------------------------------------------------------
# Required for the web UI when AUTH_ENABLED=1. Pick a real password!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to 0 only for local development (no login at all).
AUTH_ENABLED=1

# --- Secrets -----------------------------------------------------------------
# REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- State machine -----------------------------------------------------------
# Initial state: GREEN (camera off, privacy-safe) | YELLOW | RED
STARTUP_STATE=GREEN

# --- GPIO pins (BCM numbering — verify against your Pi 5 pinout!) -------------
RED_LED_PIN=17
YELLOW_LED_PIN=27
GREEN_LED_PIN=22
BUTTON_PIN=23

# --- Camera ------------------------------------------------------------------
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=24
# 0 | 90 | 180 | 270 — rotate the feed if your camera is mounted sideways
CAMERA_ROTATION=0

# --- Live stream -------------------------------------------------------------
STREAM_FPS=15
# Hard cap on simultaneous live viewers (0 = unlimited)
STREAM_MAX_VIEWERS=8

# --- Motion detection (disabled by default; part of the detection pipeline) --
MOTION_ENABLED=0
# Fraction of changed pixels that counts as motion (0.02 = 2%)
MOTION_THRESHOLD=0.02
# Minimum changed-pixel count for a motion event to register
MOTION_MIN_AREA=200

# --- Pet / dog detection (disabled by default) --------------------------------
PET_DETECTION_ENABLED=0
PET_MODEL=yolov8n

# --- Discord notifications ----------------------------------------------------
# Webhook URL of a channel the bot can post to. Empty = notifications off.
DISCORD_WEBHOOK_URL=

# 20 minutes between alerts; NOT reset by continued motion.
NOTIFICATION_COOLDOWN_SECONDS=1200

# --- Viewer tracking / SSE -----------------------------------------------------
VIEWER_TIMEOUT_SECONDS=5
SSE_HEARTBEAT_SECONDS=15

# --- Security hardening --------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
CSRF_ENABLED=1
SESSION_LIFETIME_HOURS=24
# Secure cookies + HSTS when APP_ENV=production (behind HTTPS)
REQUIRE_HTTPS_IN_PROD=1

# --- Storage -------------------------------------------------------------------
# Where captured snapshot images are written (git-ignored)
DATA_DIR=media
